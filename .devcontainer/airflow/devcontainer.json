{
  "name": "SE4AI Week 6 pipeline + Apache Airflow",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "pip install -r requirements.txt && bash orchestration/install_airflow.sh",
  "hostRequirements": { "memory": "4gb" },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Airflow UI", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
